{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wdl/lw-pr-fv-15",
	"version": "1.0.0",
	"title": "固定ページタイトル 15(動画背景)",
	"category": "lw-firstview",
	"icon": "cover-image",
	"editorScript": "file:./lw-pr-fv-15.js",
	"aiHint": {
		"description": "左テキスト+右画像FV。CTAボタン付き。動画背景対応。IT・Web・教育系に最適",
		"excludeFromAutoSelect": false,
		"contentAttributes": [
			"mainTitle",
			"description",
			"buttonText"
		],
		"imageAttributes": [
			"imageUrlPc",
			"imageUrlSp"
		],
		"notes": "濃い地色（bgColor）の面の中央に画像が帯のように入り、その上に見出し＋説明＋CTAが中央寄せで乗る。「左テキスト＋右画像の2カラム」ではない（2026-08-26 に実物で確認）。写真が1枚しか無くても締まって見えるので、素材が少ない業種に向く。bgColor を業種の色にすると印象が決まる。 ［2026-08-27 追記］左半分が bgColor の帯になる（既定は白）。titleColor を白にするなら bgColor も暗くする。imageUrlPc は空にできない（<img src=\"\"> が出る）。"
	},
	"supports": {
		"anchor": true
	},
	"attributes": {
		"mainTitle": {
			"type": "string",
			"default": "くらしを楽しく、美しく"
		},
		"description": {
			"type": "string",
			"default": "ここに説明文が入ります。ここに説明文が入ります。"
		},
		"backgroundType": {
			"type": "string",
			"default": "image"
		},
		"videoUrl": {
			"type": "string",
			"default": ""
		},
		"imageUrlPc": {
			"type": "string",
			"default": "https://liteword-assets.bigi-ishikawa.workers.dev/t/fv/sub_4.webp"
		},
		"imageUrlSp": {
			"type": "string",
			"default": ""
		},
		"imageAlt": {
			"type": "string",
			"default": ""
		},
		"bgColor": {
			"type": "string",
			"default": "#082137"
		},
		"filterColor": {
			"type": "string",
			"default": "#121416"
		},
		"filterOpacity": {
			"type": "number",
			"default": 0.2
		},
		"videoSpeed": {
			"type": "number",
			"default": 1
		},
		"headingLevel": {
			"type": "number",
			"default": 2
		},
		"strokeWidth": {
			"type": "number",
			"default": 0
		},
		"strokeWidthSp": {
			"type": "number",
			"default": 0
		},
		"strokeColor": {
			"type": "string",
			"default": "#ffffff"
		},
		"strokeOpacity": {
			"type": "number",
			"default": 0.6
		},
		"titleColor": {
			"type": "string",
			"default": "#FFFFFF"
		},
		"titleFontWeight": {
			"type": "string",
			"default": "700"
		},
		"titleFont": {
			"type": "string",
			"default": ""
		},
		"descriptionColor": {
			"type": "string",
			"default": "#ffffff"
		},
		"descriptionFontWeight": {
			"type": "string",
			"default": "600"
		},
		"descriptionFont": {
			"type": "string",
			"default": ""
		},
		"showButton": {
			"type": "boolean",
			"default": true
		},
		"buttonText": {
			"type": "string",
			"default": "ご相談はこちら"
		},
		"buttonUrl": {
			"type": "string",
			"default": ""
		},
		"buttonLinkType": {
			"type": "string",
			"default": "url"
		},
		"buttonPageId": {
			"type": "number",
			"default": 0
		},
		"buttonCategoryId": {
			"type": "number",
			"default": 0
		},
		"ctaBgColor": {
			"type": "string",
			"default": "#E95555"
		},
		"ctaTextColor": {
			"type": "string",
			"default": "#ffffff"
		},
		"ctaBorderRadius": {
			"type": "number",
			"default": 3
		},
		"ctaBorderWidth": {
			"type": "number",
			"default": 0
		},
		"ctaBorderColor": {
			"type": "string",
			"default": "#ffffff"
		}
	},
	"no": 15
}
