{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wdl/lw-list-4",
	"version": "1.0.0",
	"title": "list 04",
	"category": "lw-list",
	"icon": "lightbulb",
	"supports": {
		"anchor": true
	},
	"aiHint": {
		"description": "枠で囲ったチェックマーク付きのリスト。1列か2列。お約束・特長・持ち物・注意事項など、短い一文を並べる場面に",
		"excludeFromAutoSelect": false,
		"contentAttributes": ["contents"],
		"imageAttributes": ["iconUrl"],
		"notes": "contents は [{ text }] の配列。🚨 カードではない。枠線と背景は ul にまとめて1つ掛かるだけで、中の li には枠も背景も無い。実体は枠で囲ったチェックリスト。🚨 colClass は clm_1（1列）と clm_2（2列）の2つだけ。エディタの選択肢も2つで CSS にも clm_3 は無いので、3列を指定しても1列のまま何も起きない（旧 aiHint の 1〜3カラム対応 は誤り。2026-08-29 に実測して直した）。clm_2 にするなら項目数は偶数にする（750px以下で1列に戻る）。チェックのアイコンは SVG 固定で色だけ colorLiSvg で変わる（iconUrl に画像URLを入れれば絵を差し替えられる）。borderColor / colorLiSvg はインラインstyleに直接入るので var(--color-main) を渡してよい。maxWidth の既定 800 が ul の max-width になる。1行に入るのは PC で約35字・375px では約13字なので、375px で2行に収めたいなら1件25字までにする。自前で margin:24px 0 を持つので前後にスペーサーを足さない。noBorder:true にすると枠と内側の余白がまるごと消えて、ただのチェックリストになる。"
	},
	"attributes": {
		"fontLi": { "type": "string", "default": "", "aiHint": { "skip": true } },
		"fontWeightLi": { "type": "string", "default": "", "aiHint": { "skip": true } },
		"sizeLi": { "type": "string", "default": "size_m", "aiHint": { "skip": true } },
		"textColor": { "type": "string", "default": "", "aiHint": { "skip": true } },
		"colorLiSvg": { "type": "string", "default": "var(--color-main)", "aiHint": { "skip": true } },
		"iconUrl": {
			"type": "string",
			"default": "",
			"aiHint": { "role": "image", "note": "アイコン画像URL。省略可" }
		},
		"iconSize": { "type": "number", "default": 1.2, "aiHint": { "skip": true } },
		"iconPositionTop": { "type": "boolean", "default": false, "aiHint": { "skip": true } },
		"borderColor": { "type": "string", "default": "var(--color-main)", "aiHint": { "skip": true } },
		"borderWidth": { "type": "number", "default": 2, "aiHint": { "skip": true } },
		"borderStyle": { "type": "string", "default": "solid", "aiHint": { "skip": true } },
		"borderRadius": { "type": "number", "default": 0.5, "aiHint": { "skip": true } },
		"maxWidth": { "type": "number", "default": 800, "aiHint": { "skip": true } },
		"bgColor": { "type": "string", "default": "#fff", "aiHint": { "skip": true } },
		"colClass": { "type": "string", "default": "clm_1", "aiHint": { "skip": true } },
		"noBorder": { "type": "boolean", "default": false, "aiHint": { "skip": true } },
		"contents": {
			"type": "array",
			"source": "query",
			"selector": ".lw-list-4__li",
			"query": {
				"text": {
					"type": "string",
					"source": "html",
					"selector": ".lw-list-4__text p"
				}
			},
			"default": [
				{ "text": "リストテキストリストテキスト " },
				{ "text": "リストテキストリストテキスト " },
				{ "text": "リストテキストリストテキスト " },
				{ "text": "リストテキストリストテキスト " }
			],
			"aiHint": { "role": "list", "contentGuide": "カード項目。3〜8個。各text 10〜30文字", "example": [{"text": "駅から徒歩3分の好立地"}] }
		}
	},
	"editorScript": "file:./lw-list-4.js",
	"no": 4
}