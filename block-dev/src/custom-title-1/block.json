{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wdl/custom-title-1",
	"version": "1.0.0",
	"title": "見出しタイトル 01",
	"no": 1,
	"category": "lw-heading",
	"icon": "editor-textcolor",
	"description": "メインタイトルとサブタイトルを表示する見出しブロック",
	"supports": {
		"anchor": true
	},
	"aiHint": {
		"description": "基本見出し。メインタイトル+サブタイトル。中央配置。セクション区切りの汎用見出し",
		"excludeFromAutoSelect": false,
		"contentAttributes": ["mainTitle", "subTitle"],
		"imageAttributes": []
	},
	"attributes": {
		"mainTitle": {
			"type": "string",
			"default": "タイトル",
			"aiHint": { "role": "heading", "contentGuide": "セクション見出し。3〜15文字", "example": "私たちの強み" }
		},
		"subTitle": {
			"type": "string",
			"default": "サブタイトル",
			"aiHint": { "role": "subheading", "contentGuide": "英語表記 or 補足テキスト", "example": "OUR STRENGTHS" }
		},
		"headingLevel": {
			"type": "number",
			"default": 2,
			"aiHint": { "skip": true }
		},
		"subMarginTopPc": {
			"type": "number",
			"default": 0.2,
			"aiHint": { "skip": true }
		},
		"subMarginTopSp": {
			"type": "number",
			"default": 0.2,
			"aiHint": { "skip": true }
		}
	},
	"editorScript": "file:./custom-title-1.js"
}