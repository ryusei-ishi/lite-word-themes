{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wdl/lw-list-1",
	"version": "1.0.0",
	"title": "List 01",
	"category": "lw-list",
	"icon": "editor-ul",
	"supports": {
		"anchor": true
	},
	"aiHint": {
		"description": "番号付きリスト。番号+テキストの繰り返し。特徴・メリット一覧に。見出しなし",
		"excludeFromAutoSelect": false,
		"contentAttributes": ["contents"],
		"imageAttributes": []
	},
	"attributes": {
		"contents": {
			"type": "array",
			"source": "query",
			"selector": ".lw-list-1_content",
			"query": {
				"text": {
					"type": "string",
					"source": "html",
					"selector": ".lw-list-1_text p"
				},
				"number": {
					"type": "string",
					"source": "text",
					"selector": ".no"
				}
			},
			"default": [
				{
					"text": "初心者向けの動画マニュアルで、誰でも簡単、スムーズに制作！",
					"number": "1"
				},
				{
					"text": "ページテンプレートが用意されているので、ワンクリックで固定ページがほぼ完成！",
					"number": "2"
				},
				{
					"text": "業種別デザイナーテンプレートを使うことで、プロ級のサイトが出来る！",
					"number": "3"
				}
			],
			"aiHint": { "role": "list", "contentGuide": "リスト項目。3〜8個。各text 15〜40文字。体言止めか「〜できる」形で統一", "example": [{"text": "初回カウンセリング無料で安心", "number": "1"}] }
		},
		"noFontSet": { "type": "string", "default": "", "aiHint": { "skip": true } },
		"noFontWeight": { "type": "string", "default": "", "aiHint": { "skip": true } },
		"textFontSet": { "type": "string", "default": "", "aiHint": { "skip": true } },
		"textFontWeight": { "type": "string", "default": "", "aiHint": { "skip": true } },
		"borderColor": { "type": "string", "default": "var(--color-main)", "aiHint": { "skip": true } }
	},
	"editorScript": "file:./lw-list-1.js",
	"no": 1
}