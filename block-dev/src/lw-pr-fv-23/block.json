{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wdl/lw-pr-fv-23",
	"version": "1.0.0",
	"title": "FV 23 リード獲得（QRコードで登録）",
	"category": "lw-firstview",
	"icon": "smartphone",
	"editorScript": "file:./lw-pr-fv-23.js",
	"aiHint": {
		"description": "リード獲得ページ専用のFV。左に「登録するとできること」と大きな登録ボタン、右に白いカードでQRコードとアカウント名を出す。パソコンの人はQRコードを読み取り、スマホの人はボタンを押す、という2つの道が1画面で完結する。LINE公式アカウント・メールマガジン・アプリ・会員登録・オンラインサロンの入口に使う",
		"excludeFromAutoSelect": false,
		"contentAttributes": [
			"eyebrow",
			"mainTitle",
			"description",
			"benefitItems",
			"buttonText",
			"buttonSub",
			"qrCaption",
			"accountLabel",
			"accountName",
			"noteText"
		],
		"imageAttributes": [
			"imageUrlPc",
			"imageUrlSp",
			"qrUrl"
		],
		"notes": [
			"qrUrl には自分のQRコードの画像を入れる。空のままだと右のカードからQRコードだけが消え、アカウント名とボタンだけが残る（壊れはしないが、パソコンの人の入口が無くなる）。",
			"🚨 QRコードの画像は必ず自分のアカウントのものを入れる。見本の画像は入っていない。",
			"showQrOnSp は既定 false。スマホで自分の画面のQRコードは読み取れないので、スマホではQRを隠してボタンだけにする。ここを true にするのは、印刷や店頭の掲示に使うページのときだけ。",
			"buttonUrl には登録の飛び先を入れる（LINEなら友だち追加のURL、メルマガなら登録フォーム）。外のサービスへ飛ばすので buttonOpenNewTab は既定 true。",
			"LINE公式アカウントに合わせてボタンを緑（#06C755）にするときは、文字色（ctaTextColor）も一緒に見直すこと。白文字＋#06C755 は 2.6:1 しかなく読みにくい。既定は白いボタンに濃い緑の文字で、濃い地色の上でいちばん目立つ組み合わせにしてある。",
			"benefitItems は { text } の並び。「登録するとできること」を3つ前後で書く。🚨 登録されない理由はほとんど「何が届くか分からない」「やめ方が分からない」の2つなので、できることの一覧と、noteText の「いつでも解除できます」は両方とも残すこと。",
			"accountLabel と accountName は「ID @lite-word」のように出る。検索で探す人のための逃げ道。要らなければ showAccount を false に。",
			"🚨 自分から全幅になる背景ブロック。次の段も全幅の帯なら、あいだにスペーサーを置かない。"
		]
	},
	"supports": {
		"anchor": true
	},
	"attributes": {
		"backgroundType": { "type": "string", "default": "color" },
		"bgColor": { "type": "string", "default": "#1c4532" },
		"imageUrlPc": { "type": "string", "default": "" },
		"imageUrlSp": { "type": "string", "default": "" },
		"imageAlt": { "type": "string", "default": "" },
		"filterColor": { "type": "string", "default": "#1c4532" },
		"filterOpacity": { "type": "number", "default": 0.88 },
		"minHeightPc": { "type": "string", "default": "min-h-pc-520px" },
		"minHeightTb": { "type": "string", "default": "min-h-tb-440px" },
		"minHeightSp": { "type": "string", "default": "" },
		"maxWidth": { "type": "number", "default": 1120 },
		"cardWidth": { "type": "number", "default": 340 },
		"showEyebrow": { "type": "boolean", "default": true },
		"eyebrow": { "type": "string", "default": "登録は無料・30秒" },
		"eyebrowColor": { "type": "string", "default": "#9fd9b8" },
		"headingLevel": { "type": "number", "default": 1 },
		"mainTitle": { "type": "string", "default": "ご予約も空き状況も、<br>ここでお知らせします" },
		"titleColor": { "type": "string", "default": "#ffffff" },
		"titleFontWeight": { "type": "string", "default": "700" },
		"titleFont": { "type": "string", "default": "" },
		"titleFontSizePc": { "type": "number", "default": 40 },
		"titleFontSizeSp": { "type": "number", "default": 27 },
		"description": { "type": "string", "default": "電話がつながらない時間でも、こちらからならご相談いただけます。営業のご連絡は送りません。" },
		"descriptionColor": { "type": "string", "default": "#d5e7dc" },
		"showBenefits": { "type": "boolean", "default": true },
		"benefitItems": {
			"type": "array",
			"default": [
				{ "text": "その日の空き状況が届きます" },
				{ "text": "ご予約の変更がひと言で済みます" },
				{ "text": "登録した方だけのご案内があります" }
			]
		},
		"benefitTextColor": { "type": "string", "default": "#eaf4ee" },
		"benefitMarkColor": { "type": "string", "default": "#1c4532" },
		"benefitMarkBgColor": { "type": "string", "default": "#9fd9b8" },
		"buttonText": { "type": "string", "default": "無料で登録する" },
		"buttonSub": { "type": "string", "default": "登録は30秒で終わります" },
		"buttonUrl": { "type": "string", "default": "" },
		"buttonLinkType": { "type": "string", "default": "url" },
		"buttonPageId": { "type": "number", "default": 0 },
		"buttonCategoryId": { "type": "number", "default": 0 },
		"buttonOpenNewTab": { "type": "boolean", "default": true },
		"ctaBgColor": { "type": "string", "default": "#ffffff" },
		"ctaTextColor": { "type": "string", "default": "#0d5c36" },
		"ctaSubColor": { "type": "string", "default": "#2f6b4d" },
		"ctaBorderRadius": { "type": "number", "default": 8 },
		"cardBgColor": { "type": "string", "default": "#ffffff" },
		"cardTextColor": { "type": "string", "default": "#3a4640" },
		"cardBorderColor": { "type": "string", "default": "#d7e4dc" },
		"cardBorderRadius": { "type": "number", "default": 12 },
		"showQr": { "type": "boolean", "default": true },
		"qrUrl": { "type": "string", "default": "" },
		"qrAlt": { "type": "string", "default": "登録用のQRコード" },
		"qrSize": { "type": "number", "default": 180 },
		"qrCaption": { "type": "string", "default": "スマホのカメラをかざすと開きます" },
		"showQrOnSp": { "type": "boolean", "default": false },
		"showAccount": { "type": "boolean", "default": true },
		"accountLabel": { "type": "string", "default": "ID" },
		"accountName": { "type": "string", "default": "@your-account" },
		"noteText": { "type": "string", "default": "登録は無料です。いつでもご自分で解除できます。" },
		"noteColor": { "type": "string", "default": "#b8d3c4" }
	},
	"no": 23
}
