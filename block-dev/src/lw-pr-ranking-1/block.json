					"comment": "選んだ理由をひとことで書きます。どんな人に向いているかを書くと選びやすくなります。",
					"score": "4.4",
					"good": "ここが良かった点を書きます",
					"bad": "気になった点も正直に書きます",
					"shops": [
						{ "label": "Amazonで見る", "url": "", "bgColor": "#ff9900", "textColor": "#ffffff" },
						{ "label": "楽天市場で見る", "url": "", "bgColor": "#bf0000", "textColor": "#ffffff" },
						{ "label": "Yahoo!で見る", "url": "", "bgColor": "#ff0033", "textColor": "#ffffff" }
					]
				},
				{
					"imageUrl": "", "imageAlt": "",
					"name": "3位の商品名を入れてください",
					"comment": "選んだ理由をひとことで書きます。どんな人に向いているかを書くと選びやすくなります。",
					"score": "4.1",
					"good": "ここが良かった点を書きます",
					"bad": "気になった点も正直に書きます",
					"shops": [
						{ "label": "Amazonで見る", "url": "", "bgColor": "#ff9900", "textColor": "#ffffff" },
						{ "label": "楽天市場で見る", "url": "", "bgColor": "#bf0000", "textColor": "#ffffff" },
						{ "label": "Yahoo!で見る", "url": "", "bgColor": "#ff0033", "textColor": "#ffffff" }
					]
				}
			],
			"aiHint": {
				"role": "list",
				"contentGuide": "ランキングの中身。並べた順が順位になる。各要素は name / comment / score / good / bad / imageUrl / shops"
			}
		},
		"rankStyle": { "type": "string", "default": "number" },
		"rankUnit": { "type": "string", "default": "位" },
