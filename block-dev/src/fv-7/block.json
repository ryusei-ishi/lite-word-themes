{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wdl/fv-7",
	"version": "1.0.0",
	"title": "固定ページタイトル 07(トップ用・動画背景)",
	"category": "lw-firstview",
	"icon": "cover-image",
	"editorScript": "file:./fv-7.js",
	"supports": {
		"anchor": true
	},
	"aiHint": {
		"description": "動画背景FV。中央テキスト+ボタン+mp4/Vimeo背景。インパクト重視のトップページ向け",
		"excludeFromAutoSelect": true,
		"excludeReason": "動画URLをAIが生成できないため。ユーザーが手動で動画を設定する",
		"contentAttributes": ["mainTitle", "subTitle", "description", "buttonText", "buttonUrl"],
		"imageAttributes": []
	},
	"attributes": {
		"subTitle": {
			"type": "string",
			"default": "初心者のためのWordPressテーマ",
			"aiHint": { "role": "subheading", "contentGuide": "英語表記 or サブキャッチ", "example": "CREATIVE AGENCY" }
		},
		"mainTitle": {
			"type": "string",
			"default": "LiteWord",
			"aiHint": { "role": "heading", "contentGuide": "キャッチコピー。5〜15文字", "example": "映像で魅せる" }
		},
		"description": {
			"type": "string",
			"default": "テキストテキストテキストテキストテキストテキスト",
			"aiHint": { "role": "body", "contentGuide": "サービスの価値を1〜2文で。20〜50文字", "example": "私たちの映像制作で、あなたのビジネスを次のステージへ" }
		},
		"buttonText": {
			"type": "string",
			"default": "詳細はこちら",
			"aiHint": { "role": "button", "contentGuide": "動詞形。4〜10文字", "example": "お問い合わせ" }
		},
		"buttonUrl": {
			"type": "string",
			"default": "",
			"aiHint": { "role": "url", "contentGuide": "#contact 等のページ内リンク推奨" }
		},
		"showButton": {
			"type": "boolean",
			"default": true,
			"aiHint": { "skip": true }
		},
		"videoType": {
			"type": "string",
			"default": "media",
			"aiHint": { "skip": true }
		},
		"videoUrl": {
			"type": "string",
			"default": "https://cdn.pixabay.com/video/2023/11/19/189813-887078786_large.mp4",
			"aiHint": { "skip": true, "note": "動画URLはユーザーが手動設定" }
		},
		"vimeoId": {
			"type": "string",
			"default": "",
			"aiHint": { "skip": true }
		},
		"filterColor": {
			"type": "string",
			"default": "#000000",
			"aiHint": { "skip": true }
		},
		"filterOpacity": {
			"type": "number",
			"default": 0.5,
			"aiHint": { "skip": true }
		},
		"videoSpeed": {
			"type": "number",
			"default": 1.0,
			"aiHint": { "skip": true }
		},
		"headingLevel": {
			"type": "number",
			"default": 1,
			"aiHint": { "skip": true }
		},
		"minHeightPc": {
			"type": "string",
			"default": "",
			"aiHint": { "skip": true }
		},
		"minHeightTb": {
			"type": "string",
			"default": "",
			"aiHint": { "skip": true }
		},
		"minHeightSp": {
			"type": "string",
			"default": "",
			"aiHint": { "skip": true }
		}
	},
	"no": 7
}