{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wdl/lw-pr-before-after-3",
	"version": "1.0.0",
	"title": "ビフォーアフター 03",
	"category": "lw-voice",
	"icon": "format-image",
	"editorScript": "file:./lw-pr-before-after-3.js",
	"aiHint": {
		"description": "ビフォーアフター。左右に画像+テキストで比較表示。施術結果・リフォーム事例に",
		"excludeFromAutoSelect": false,
		"contentAttributes": [
			"beforeText",
			"afterText",
			"beforeDescription",
			"afterDescription"
		],
		"imageAttributes": [
			"beforeImageUrl",
			"afterImageUrl"
		]
	},
	"supports": {
		"anchor": true
	},
	"attributes": {
		"beforeImageUrl": {
			"type": "string",
			"default": "https://lite-word.com/sample_img/before_after/1_1.webp"
		},
		"beforeImageAlt": {
			"type": "string",
			"default": ""
		},
		"beforeText": {
			"type": "string",
			"default": "Before"
		},
		"beforeDescription": {
			"type": "string",
			"default": ""
		},
		"afterImageUrl": {
			"type": "string",
			"default": "https://lite-word.com/sample_img/before_after/1_2.webp"
		},
		"afterImageAlt": {
			"type": "string",
			"default": ""
		},
		"afterText": {
			"type": "string",
			"default": "After"
		},
		"afterDescription": {
			"type": "string",
			"default": ""
		},
		"beforeTextBgColor": {
			"type": "string",
			"default": "#e64343"
		},
		"afterTextBgColor": {
			"type": "string",
			"default": "#e64343"
		},
		"arrowBgColor": {
			"type": "string",
			"default": "#e64343"
		},
		"maxWidth": {
			"type": "number",
			"default": 800
		},
		"aspectRatioHeight": {
			"type": "number",
			"default": 800
		},
		"hasImageShadow": {
			"type": "boolean",
			"default": false
		}
	},
	"no": 3
}