{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wdl/paid-block-content-5",
	"version": "1.0.0",
	"title": "Content 05",
	"category": "lw-content",
	"icon": "format-image",
	"editorScript": "file:./paid-block-content-5.js",
	"aiHint": {
		"description": "フルワイド画像+テキストオーバーレイ。大きな背景画像の上にタイトル+説明文。インパクト重視の紹介セクションに",
