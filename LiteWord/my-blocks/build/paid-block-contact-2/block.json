{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wdl/paid-block-contact-2",
	"version": "1.0.0",
	"title": "お問合わせフォーム 02",
	"category": "lw-contact",
	"icon": "email",
	"aiHint": {
		"description": "実際に送信できるお問い合わせフォーム。背景写真の帯の中に見出し＋説明＋フォーム。お問い合わせページ本体に",
		"excludeFromAutoSelect": false,
		"contentAttributes": [
			"mainTitle",
			"subTitle",
			"description"
		],
		"imageAttributes": [
			"bgImageUrl",
			"bgImageUrlSp"
		],
		"notes": "フォーム本体は属性ではなく、save() が書き出すショートコード [lw_mail_form_select id=1] を、表示のときに PHP（functions/mail_form/form_put.php）が展開して作る。だから項目を増やす・減らすのは管理画面の Lwお問い合わせ からで、AI が書けるのはmainTitle / subTitle / description の3つだけ。フォームの中身は生成しなくてよい。⚠️ フォームを1つも作っていないサイトでも空にならない。lw_mail_form_set_1 が無ければお名前／メールアドレス／お問合せ内容 の3項目が既定で出て、送信先も未設定ならWordPress の管理者メールアドレスに届く（2026-08-28 に form_put.php と mail-ajax.php で確認）。⚠️ mainTitleLevel の既定は h1。ページの途中に置くセクションでは h2 にすること。⚠️ 見出しは main が48px・sub が16px で、文字サイズは属性で変えられない。他のセクションと語順をそろえるなら main に日本語・sub に英字を入れるが、その分だけ大きく出る。⚠️ mainTitle と subTitle を空にすると空の見出しタグがHTMLに残るので空にしない。"
	},
	"supports": {
		"anchor": true
	},
	"editorScript": "file:./paid-block-contact-2.js",
	"no": 2,
	"attributes": {
		"formId": {
			"type": "number",
			"default": 1
		},
		"mainTitle": {
			"type": "string",
			"default": "CONTACT"
		},
		"subTitle": {
			"type": "string",
			"default": "お問合わせフォーム"
		},
		"description": {
			"type": "string",
			"default": "ご不明な点やご相談がございましたら、下記のお問い合わせフォームよりお気軽にご連絡ください。"
		},
		"bgImageUrl": {
			"type": "string",
			"default": "https://lite-word.com/sample_img/background/6.webp"
		},
		"bgImageUrlSp": {
			"type": "string",
			"default": ""
		},
		"bgColor": {
			"type": "string",
			"default": "#03294C"
		},
		"bgOpacity": {
			"type": "number",
			"default": 0.5
		},
		"textColor": {
			"type": "string",
			"default": "",
			"aiHint": {
				"skip": true
			}
		},
		"inputBgColor": {
			"type": "string",
			"default": "",
			"aiHint": {
				"skip": true
			}
		},
		"inputBorderColor": {
			"type": "string",
			"default": "",
			"aiHint": {
				"skip": true
			}
		},
		"requiredBgColor": {
			"type": "string",
			"default": "#da3838"
		},
		"submitBgColor": {
			"type": "string",
			"default": "#EE3131"
		},
		"mainTitleLevel": {
			"type": "string",
			"default": "h1"
		},
		"maxWidth": {
			"type": "string",
			"default": "800px"
		},
		"descriptionAlignPC": {
			"type": "string",
			"default": "pc_center"
		},
		"descriptionAlignSP": {
			"type": "string",
			"default": "sp_center"
		}
	}
}