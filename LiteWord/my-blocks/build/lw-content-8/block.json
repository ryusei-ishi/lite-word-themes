{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wdl/lw-content-8",
	"version": "1.0.0",
	"title": "Content 08",
	"category": "lw-content",
	"icon": "lightbulb",
	"editorScript": "file:./lw-content-8.js",
	"aiHint": {
		"description": "サブ（英字バッジ）＋見出し＋説明文＋ボタンのカードが並ぶ。写真が無くても成立する。強み・プラン・免許や許可など、1件ずつ読ませたいものを並べるときに",
		"excludeFromAutoSelect": false,
		"contentAttributes": ["contents"],
		"imageAttributes": [],
		"notes": "サブ（英字の小さなバッジ）＋見出し＋説明文＋ボタンのカードが並ぶ。写真が無くても成立する。強み・プラン・免許や許可のように、1件ずつ読ませたいものを並べるときに。列は columnClass（clm_2 / clm_3 / clm_4・既定は clm_3）。800px以下で2カラム、550px以下で1カラムに落ちる。🚨 固定ページでは画面幅いっぱいに広がる（.lw_content_wrap.page で width:100vw）。内側の幅は innerMaxWidth（既定1200）で決まるので、同じページの他のブロックと幅をそろえたいときは 1040 などを明示する。🚨 このブロックをページの一番上に置くと、本文の上の余白（.first_content）が消える。全幅ブロックをファーストビューとして使うための仕掛けなので、途中に置くぶんには関係ない。🚨 リンク先が無い一覧では showButton:false にして全カードのボタンを消す。既定ではボタンが出るので、contents[].url を空のままにすると href=\"\" のボタンが並び、押すとページが再読み込みされる。ボタンを出すなら url を必ず入れる。カードの枠線・サブのバッジ・ボタンは既定がすべて var(--color-main) で、ページのメインカラーに自動で追従する（色は指定しなくてよい）。showSub:false でバッジを消せる。文字の大きさは titleFontSizeClass / textFontSizeClass（font_size_s / m / l）。contents は sub（英字3〜10字。バッジなので短く）＋ main（日本語5〜15字）＋ text（40〜70字）。カードの高さは一番長い text にそろう。mainAlign:\"center\" で見出しを中央寄せにできる。自前で margin:40px 0 を持つので、前後にスペーサーを足さない。"
	},
	"supports": {
		"anchor": true
	},
	"attributes": {
		"fontLi": {
			"type": "string",
			"default": ""
		},
		"fontColorLi": {
			"type": "string",
			"default": ""
		},
		"fontWeightLi": {
			"type": "string",
			"default": "600"
		},
		"titleFontSizeClass": {
			"type": "string",
			"default": "font_size_m"
		},
		"fontLiP": {
			"type": "string",
			"default": ""
		},
		"fontColorLiP": {
			"type": "string",
			"default": "var(--color-black)"
		},
		"fontWeightLiP": {
			"type": "string",
			"default": "400"
		},
		"textFontSizeClass": {
			"type": "string",
			"default": "font_size_m"
		},
		"titleTag": {
			"type": "string",
			"default": "h3"
		},
		"titleBorderColor": {
			"type": "string",
			"default": "var(--color-main)"
		},
		"titleBorderSize": {
			"type": "number",
			"default": 2
		},
		"liBorderColor": {
			"type": "string",
			"default": "var(--color-main)"
		},
		"liBorderSize": {
			"type": "number",
			"default": 2
		},
		"liPaddingTop": {
			"type": "number",
			"default": 24
		},
		"liPaddingBottom": {
			"type": "number",
			"default": 24
		},
		"liPaddingLeft": {
			"type": "number",
			"default": 24
		},
		"liPaddingRight": {
			"type": "number",
			"default": 24
		},
		"liBorderRadius": {
			"type": "number",
			"default": 8
		},
		"subBorderColor": {
			"type": "string",
			"default": "var(--color-main)"
		},
		"subBorderSize": {
			"type": "number",
			"default": 1
		},
		"subFontColor": {
			"type": "string",
			"default": "var(--color-main)"
		},
		"subBgColor": {
			"type": "string",
			"default": "#ffffff"
		},
		"showSub": {
			"type": "boolean",
			"default": true
		},
		"fontLiSub": {
			"type": "string",
			"default": ""
		},
		"fontWeightLiSub": {
			"type": "string",
			"default": "600"
		},
		"fontLiMain": {
			"type": "string",
			"default": ""
		},
		"fontWeightLiMain": {
			"type": "string",
			"default": "700"
		},
		"columnClass": {
			"type": "string",
			"default": "clm_3"
		},
		"mainAlign": {
			"type": "string",
			"default": "left"
		},
		"innerMaxWidth": {
			"type": "number",
			"default": 1200
		},
		"btnMarginTop": {
			"type": "number",
			"default": 16
		},
		"btnHeight": {
			"type": "number",
			"default": 56
		},
		"btnBgColor": {
			"type": "string",
			"default": "var(--color-main)"
		},
		"btnFontColor": {
			"type": "string",
			"default": "#ffffff"
		},
		"btnFontSize": {
			"type": "number",
			"default": 15
		},
		"btnBorderRadius": {
			"type": "number",
			"default": 2
		},
		"btnBorderColor": {
			"type": "string",
			"default": "var(--color-main)"
		},
		"btnBorderSize": {
			"type": "number",
			"default": 0
		},
		"showButton": {
			"type": "boolean",
			"default": true
		},
		"contents": {
			"type": "array",
			"source": "query",
			"selector": ".lw-content-8__li",
			"query": {
				"sub": {
					"type": "string",
					"source": "html",
					"selector": ".ttl .sub"
				},
				"main": {
					"type": "string",
					"source": "html",
					"selector": ".ttl .main"
				},
				"text": {
					"type": "string",
					"source": "html",
					"selector": ".lw-content-8__text"
				},
				"url": {
					"type": "string",
					"source": "attribute",
					"selector": ".link",
					"attribute": "href",
					"default": ""
				},
				"btnText": {
					"type": "string",
					"source": "html",
					"selector": ".link_btn",
					"default": "詳細はこちら"
				},
				"linkType": { "type": "string", "source": "attribute", "selector": ".link", "attribute": "data-lw-link-type" },
				"linkId": { "type": "string", "source": "attribute", "selector": ".link", "attribute": "data-lw-link-id" }
			},
			"default": [
				{
					"sub": "ABOUT",
					"main": "はじめての方へ",
					"text": "どんな流れで進むのかを、初めての方にも分かるようにご説明します。",
					"url": "#",
					"btnText": "詳細はこちら"
				},
				{
					"sub": "PRICE",
					"main": "料金のご案内",
					"text": "かかる費用とお支払いの方法を、あらかじめお伝えしています。",
					"url": "#",
					"btnText": "詳細はこちら"
				},
				{
					"sub": "FAQ",
					"main": "よくあるご質問",
					"text": "よくいただくご質問をまとめました。ここに無いことはお気軽にどうぞ。",
					"url": "#",
					"btnText": "詳細はこちら"
				}
			],
			"aiHint": { "role": "list", "contentGuide": "カード項目。2〜4個。各要素にsub(英語3〜10文字)+main(日本語5〜15文字)+text(20〜60文字)+btnText(4〜10文字)", "example": [{"sub": "PLAN A", "main": "スタンダード", "text": "基本的なサービスを全て含むプランです", "btnText": "詳細を見る"}] }
		}
	},
	"no": 8
}