{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wdl/paid-block-content-6",
	"version": "1.0.0",
	"title": "Content 06",
	"category": "lw-content",
	"icon": "format-image",
	"editorScript": "file:./paid-block-content-6.js",
	"aiHint": {
		"description": "画像+テキスト+ボタン2カラム。シンプルな左右配置。反転可能。サービス概要説明に",
		"excludeFromAutoSelect": false,
		"contentAttributes": ["textContent", "buttonText", "buttonUrl"],
		"imageAttributes": ["imageUrl"]
