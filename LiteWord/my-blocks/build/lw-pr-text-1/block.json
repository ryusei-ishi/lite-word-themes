{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wdl/lw-pr-text-1",
	"version": "1.0.0",
	"title": "グラデーションテキスト 01",
	"category": "lw-heading",
	"icon": "admin-customizer",
	"editorScript": "file:./lw-pr-text-1.js",
	"aiHint": {
		"description": "グラデーションテキスト。テキストにグラデーション効果。見出し演出に",
		"excludeFromAutoSelect": false,
		"contentAttributes": [
			"text"
		],
		"imageAttributes": [],
		"notes": "グラデーションのアニメーションは属性では止められない。save() が gradient-slide-anime クラスを無条件に付け、CSS 側も animation の変数にフォールバック（lw-pr-text-1-gradient-slide-anime-1）を持つため、animationPattern を空にしても色が流れ続ける（2026-08-28 実測）。ずっと動いていてよいキャッチコピー向けで、会社概要の数字のように落ち着かせたい所には使わない。fontSizePc の単位は em（既定1）。48 のような px のつもりの値を渡すと 48em になって壊れる。"
	},
	"supports": {
		"anchor": true
	},
	"attributes": {
		"text": {
			"type": "string",
			"default": "SLIDE ANIMATION"
		},
		"tagName": {
			"type": "string",
			"default": "h2"
		},
		"textAlignPc": {
			"type": "string",
			"default": "left"
		},
		"textAlignSp": {
			"type": "string",
			"default": ""
		},
		"fontSet": {
			"type": "string",
			"default": ""
		},
		"fontWeight": {
			"type": "string",
			"default": ""
		},
		"fontSizePc": {
			"type": "number",
			"default": 1
		},
		"fontSizeTab": {
			"type": "number",
			"default": null
		},
		"fontSizeSp": {
			"type": "number",
			"default": null
		},
		"lineHeightPc": {
			"type": "number",
			"default": 1.5
		},
		"lineHeightTab": {
			"type": "number",
			"default": null
		},
		"lineHeightSp": {
			"type": "number",
			"default": null
		},
		"gradientPreset": {
			"type": "string",
			"default": "preset-blue"
		},
		"gradientColor1": {
			"type": "string",
			"default": "#3b82f6"
		},
		"gradientColor2": {
			"type": "string",
			"default": "#06b6d4"
		},
		"gradientColor3": {
			"type": "string",
			"default": "#3b82f6"
		},
		"gradientAngle": {
			"type": "string",
			"default": "270"
		},
		"animationPattern": {
			"type": "string",
			"default": "lw-pr-text-1-gradient-slide-anime-1"
		},
		"animationTime": {
			"type": "number",
			"default": 3
		},
		"animationEasing": {
			"type": "string",
			"default": "linear"
		}
	},
	"no": 1
}