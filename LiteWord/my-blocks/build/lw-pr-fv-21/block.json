{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wdl/lw-pr-fv-21",
	"version": "1.0.0",
	"title": "FV 21 リード獲得（もらえる物と締切）",
	"category": "lw-firstview",
	"icon": "products",
	"editorScript": "file:./lw-pr-fv-21.js",
	"aiHint": {
		"description": "リード獲得ページ専用のFV。左に「無料」の札・見出し・もらえる物の中身を番号で並べ、右にその写真を少し傾けて置く。写真の角に締切や残り枠の丸い札を添えられる。無料サンプル・資料請求・キャンペーン応募・先行案内に使う",
		"excludeFromAutoSelect": false,
		"contentAttributes": [
			"freeLabel",
			"freeText",
			"mainTitle",
			"description",
			"inboxTitle",
			"inboxItems",
			"buttonText",
			"buttonSub",
			"tagTop",
			"tagMain",
			"tagUnit",
			"tagBottom"
		],
		"imageAttributes": [
			"imageUrl"
		],
		"notes": [
			"背景は淡い色が既定（bgColor）。写真の上に文字を置くFVではないので、白っぽい面のまま使うほうが中身のリストが読みやすい。",
			"inboxItems は「箱の中に入っているもの」を番号付きで並べる箱。3つが読みやすい。空にすると箱ごと消える。",
			"🚨 締切の札（showTag）は本当に締切があるときだけ出す。ずっと「残り3日」と出したままにしない。tagMain に数字、tagUnit に単位（日・名）、tagTop と tagBottom に前後の言葉が入る。",
			"imageTilt で写真の傾きを決める（-6〜6度）。0 にすると傾かない。",
			"🚨 スマホでは締切の札が写真の左上角に付く。写真の上端にCTAボタンが接するので、締切を使うときは buttonSub を短めにすると重なって見えない。",
			"🚨 自分から全幅になる背景ブロック。次の段も全幅の帯なら、あいだにスペーサーを置かない。"
		]
	},
	"supports": {
		"anchor": true
	},
	"attributes": {
		"bgColor": { "type": "string", "default": "#f7f1ea" },
		"minHeightPc": { "type": "string", "default": "min-h-pc-560px" },
		"minHeightTb": { "type": "string", "default": "min-h-tb-460px" },
		"minHeightSp": { "type": "string", "default": "" },
		"maxWidth": { "type": "number", "default": 1140 },
		"imageSide": { "type": "string", "default": "right" },
		"imageColWidth": { "type": "number", "default": 430 },
		"imageUrl": { "type": "string", "default": "https://liteword-assets.bigi-ishikawa.workers.dev/t/sample/background/6.webp" },
		"imageAlt": { "type": "string", "default": "" },
		"imageTilt": { "type": "number", "default": -2.4 },
		"imageHeightPc": { "type": "number", "default": 330 },
		"imageHeightSp": { "type": "number", "default": 220 },
		"showFree": { "type": "boolean", "default": true },
		"freeLabel": { "type": "string", "default": "無料" },
		"freeText": { "type": "string", "default": "送料もいただきません" },
		"freeBgColor": { "type": "string", "default": "#b5642c" },
		"freeTextColor": { "type": "string", "default": "#ffffff" },
		"headingLevel": { "type": "number", "default": 1 },
		"mainTitle": { "type": "string", "default": "お試し3種が<br>ポストに届きます" },
		"titleColor": { "type": "string", "default": "#3f2618" },
		"titleFontWeight": { "type": "string", "default": "700" },
		"titleFont": { "type": "string", "default": "" },
		"titleFontSizePc": { "type": "number", "default": 45 },
		"titleFontSizeSp": { "type": "number", "default": 30 },
		"description": { "type": "string", "default": "封筒1つでポストに入ります。ご不在でも受け取れます。自動でお届けが始まることはありません。" },
		"descriptionColor": { "type": "string", "default": "#5f544c" },
		"showInbox": { "type": "boolean", "default": true },
		"inboxTitle": { "type": "string", "default": "箱の中に入っているもの" },
		"inboxItems": {
			"type": "array",
			"default": [
				{ "text": "焙煎したての豆 3種（各20g・挽き方が選べます）" },
				{ "text": "おいしく淹れるための紙 1枚" },
				{ "text": "次に使える割引券（有効期限なし）" }
			]
		},
		"inboxBgColor": { "type": "string", "default": "#ffffff" },
		"inboxBorderColor": { "type": "string", "default": "#e6dbd0" },
		"inboxTitleColor": { "type": "string", "default": "#b5642c" },
		"inboxTextColor": { "type": "string", "default": "#33302c" },
		"inboxNumBgColor": { "type": "string", "default": "#5c3d2e" },
		"inboxNumColor": { "type": "string", "default": "#ffffff" },
		"buttonText": { "type": "string", "default": "お試しを申し込む" },
		"buttonSub": { "type": "string", "default": "入力は30秒・最短3日でお届け" },
		"buttonUrl": { "type": "string", "default": "" },
		"buttonLinkType": { "type": "string", "default": "url" },
		"buttonPageId": { "type": "number", "default": 0 },
		"buttonCategoryId": { "type": "number", "default": 0 },
		"buttonMaxWidth": { "type": "number", "default": 400 },
		"ctaBgColor": { "type": "string", "default": "#b5642c" },
		"ctaTextColor": { "type": "string", "default": "#ffffff" },
		"ctaSubColor": { "type": "string", "default": "#ffe9d8" },
		"ctaBorderRadius": { "type": "number", "default": 7 },
		"showTag": { "type": "boolean", "default": true },
		"tagTop": { "type": "string", "default": "お申込み" },
		"tagMain": { "type": "string", "default": "3" },
		"tagUnit": { "type": "string", "default": "日" },
		"tagBottom": { "type": "string", "default": "まで" },
		"tagBgColor": { "type": "string", "default": "#3f2618" },
		"tagTextColor": { "type": "string", "default": "#ffffff" }
	},
	"no": 21
}
