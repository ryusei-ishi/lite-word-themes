        "excludeFromAutoSelect": true,
        "excludeReason": "InnerBlocksを使用するためAIが直接コンテンツを生成できない",
        "contentAttributes": [],
        "imageAttributes": ["imageUrl"]
    },
    "supports":  {
                     "anchor":  true
                 },
    "attributes":  {
                       "imageUrl":  {
                                        "type":  "string",
                                        "default":  "https://placehold.co/400x400",
                                        "ai_description":  "左側の画像URL"
                                    },
                       "imageAlt":  {
                                        "type":  "string",
                                        "default":  "",
                                        "ai_description":  "画像のalt属性"
                                    },
                       "maxWidth":  {
                                        "type":  "number",
                                        "default":  1040,
                                        "ai_description":  "最大幅（px）"
                                    },
                       "bgColor":  {
                                       "type":  "string",
                                       "default":  "#f5f5f5",
                                       "ai_description":  "背景色"
                                   },
                       "bdrPc":  {
                                     "type":  "number",
