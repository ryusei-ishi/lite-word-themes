                       "minHeight":  {
                                         "type":  "number",
                                         "default":  378,
                                         "ai_description":  "最小の高さ（px）"
                                     },
                       "borderWidth": {
                                         "type": "number",
                                         "default": 2,
                                         "ai_description": "枠線の太さ（px）"
