			"default": "キャッチフレーズテキスト<br>キャッチフレーズテキスト"
		},
		"description": {
			"type": "string",
			"default": "ここに説明文が入りますここに説明文が入りますここに説明文が入りますここに説明文が入りますここに説明文が入りますここに説明文が入りますここに説明文が入ります"
		},
		"headingLevel": {
			"type": "number",
			"default": 2
		},
