			"type": "boolean",
			"default": false
		},
		"showCta1BorderPicker": {
			"type": "boolean",
			"default": false
		},
		"cta2Text": {
			"type": "string",
			"default": "資料ダウンロードはこちら"
		},
		"cta2Url": {
			"type": "string",
			"default": "#"
		},
		"cta2LinkType": {
			"type": "string",
			"default": "url"
		},
		"cta2PageId": {
			"type": "number",
			"default": 0
		},
		"cta2CategoryId": {
			"type": "number",
			"default": 0
