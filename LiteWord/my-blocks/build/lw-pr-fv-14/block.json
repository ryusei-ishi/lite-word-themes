			"type": "string",
			"default": ""
		},
		"bgImgAlt": {
			"type": "string",
			"default": ""
		},
		"videoUrl": {
			"type": "string",
			"default": ""
		},
		"videoUrlSp": {
			"type": "string",
			"default": ""
		},
		"videoSpeed": {
			"type": "number",
			"default": 1
