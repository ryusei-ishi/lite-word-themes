{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wdl/lw-pr-custom-title-14",
	"version": "1.0.0",
	"title": "見出しタイトル 14",
	"category": "lw-heading",
	"icon": "editor-textcolor",
	"description": "位置調整対応見出しブロック",
	"supports": {
		"anchor": true
	},
	"aiHint": {
		"description": "位置調整対応見出し。メイン+サブタイトル。PC/SP別配置設定。角丸背景付き",
		"excludeFromAutoSelect": false,
		"contentAttributes": ["mainTitle", "subTitle"],
		"imageAttributes": [],
			"notes": "colorMain（12 は colorSub も）は `--color-main` という **テーマと同名の CSS変数** として書き出される。ここに `var(--color-main)` を渡すと `--color-main:var(--color-main)` という自己参照になり、変数ごと無効化されて**背景の帯が透明になり、白文字だけが残って見出しが消える**（2026-08-27 に実際に踏んだ）。サイトのテーマ色に合わせたいときも渡さず、色を指定しない（既定 #0a71c0）か、実際の色コードを入れる。"
		},
	"attributes": {
		"mainTitle": {
			"type": "string",
			"default": "カスタムタイトルカスタムタイトル",
			"aiHint": { "role": "heading", "contentGuide": "セクション見出し。3〜20文字", "example": "よくあるご質問" }
		},
		"subTitle": {
			"type": "string",
			"default": "サブタイトルサブタイトル",
			"aiHint": { "role": "subheading", "contentGuide": "英語表記 or 補足テキスト", "example": "FAQ" }
		},
		"headingLevel": {
			"type": "number",
			"default": 2,
			"aiHint": { "skip": true }
		},
		"colorMain": {
			"type": "string",
			"default": "#0a71c0",
			"aiHint": { "skip": true }
		},
		"colorMainText": {
			"type": "string",
			"default": "",
			"aiHint": { "skip": true }
		},
		"colorSubText": {
			"type": "string",
			"default": "",
			"aiHint": { "skip": true }
		},
		"maxWidth": {
			"type": "number",
			"default": 0,
			"aiHint": { "skip": true }
		},
		"borderRadius": {
			"type": "number",
			"default": 6,
			"aiHint": { "skip": true }
		},
		"alignmentPc": {
			"type": "string",
			"default": "",
			"aiHint": { "skip": true }
		},
		"alignmentSp": {
			"type": "string",
			"default": "",
			"aiHint": { "skip": true }
		}
	},
	"editorScript": "file:./lw-pr-custom-title-14.js",
	"no": 14
}