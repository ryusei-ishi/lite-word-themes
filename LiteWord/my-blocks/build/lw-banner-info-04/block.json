{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wdl/lw-banner-info-04",
	"version": "1.0.0",
	"title": "バナー 04（2カラム2行）",
	"category": "lw-banner",
	"icon": "images-alt2",
	"aiHint": {
		"description": "画像バナー2カラム2行。4枚のバナーを2x2グリッド配置。太字タイトル。サービスメニュー一覧に",
		"notes": "🚨 **filterOpacity の既定 0.45 では白い見出しが読めない。** 写真のいちばん明るい部分をまっ白と仮定して測ると、濃い色のフィルタでも 0.45 で 2.60:1 ／ 0.52 で 3.11:1 しかない。**0.68 で 4.90:1** になるので 0.68 以上にする（2026-09-06 実測）。items は [{title, description, imgUrl, alt, linkUrl, openInNewTab}] の形。2×2の格子なので**4件そろえる**（3件だと右下が空く）。",
		"excludeFromAutoSelect": false,
		"contentAttributes": [
			"items"
		],
		"imageAttributes": [
			"items.imgUrl"
		]
	},
	"supports": {
		"anchor": true
	},
	"attributes": {
		"filterBackgroundColor": {
			"type": "string",
			"default": "#000"
		},
		"filterOpacity": {
			"type": "number",
			"default": 0.45
		},
		"maxWidth": {
			"type": "number",
			"default": 800
		},
		"titleFontFamily": {
			"type": "string",
			"default": "Noto Sans JP"
		},
		"titleFontWeight": {
			"type": "string",
			"default": "800"
		},
		"pFontFamily": {
			"type": "string",
			"default": "Noto Sans JP"
		},
		"pFontWeight": {
			"type": "string",
			"default": "400"
		},
		"items": {
			"type": "array",
			"default": [
				{
					"title": "はじめての方へ",
					"description": "初めての方はこちら",
					"imgUrl": "https://lite-word.com/sample_img/shop/1.webp",
					"alt": "",
					"linkUrl": "",
					"openInNewTab": false
				},
				{
					"title": "サービス",
					"description": "メニュー一覧",
					"imgUrl": "https://lite-word.com/sample_img/shop/2.webp",
					"alt": "",
					"linkUrl": "",
					"openInNewTab": false
				},
				{
					"title": "料金のご案内",
					"description": "費用の目安です",
					"imgUrl": "https://lite-word.com/sample_img/shop/3.webp",
					"alt": "",
					"linkUrl": "",
					"openInNewTab": false
				},
				{
					"title": "アクセス",
					"description": "場所と行き方",
					"imgUrl": "https://lite-word.com/sample_img/shop/4.webp",
					"alt": "",
					"linkUrl": "",
					"openInNewTab": false
				}
			]
		}
	},
	"editorScript": "file:./lw-banner-info-04.js",
	"no": 2
}
