{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wdl/lw-pr-fv-19",
	"version": "1.0.0",
	"title": "FV 19 リード獲得（電話とフォームの二択）",
	"category": "lw-firstview",
	"icon": "phone",
	"editorScript": "file:./lw-pr-fv-19.js",
	"aiHint": {
		"description": "リード獲得ページ専用のFV。電話とフォームを同じ大きさで並べ、どちらでも申し込めるようにする。それぞれに「所要時間」「受付時間」を添えられる。電話番号はそのまま tel: の発信リンクになる（パソコンでも押せる）。電話相談・体験の予約・見学会・登録の呼びかけに使う",
		"excludeFromAutoSelect": false,
		"contentAttributes": [
			"eyebrow",
			"mainTitle",
			"description",
			"telKicker",
			"telNumber",
			"telHref",
			"telSub",
			"ctaKicker",
			"ctaText",
			"ctaSub",
			"safeItems"
		],
		"imageAttributes": [
			"imageUrlPc",
			"imageUrlSp"
		],
		"notes": [
			"🚨 telAsLink を true にすると、電話番号が tel: の発信リンクになる（画面幅に関係なく、パソコンでも押すと発信する）。false にすると押せない文字になる。番号は telNumber にハイフン込みで入れ、telHref には数字だけを入れる。",
			"showTel を false にすると電話側が消えてCTAが1つだけになる。逆に showCta を false にすれば電話だけになる。どちらも消すと押す場所が無くなるので、片方は必ず残すこと。",
			"safeItems は「番号を他社に渡しません」のような不安をほどく一行の並び。CTAのすぐ下に置くのが効く。空にすると帯ごと消える。",
			"eyebrow は見出しの上に出る肩ラベル。左右に斜めの線が付く。空にすると消える。",
			"🚨 自分から全幅になる背景ブロック。次の段も全幅の帯なら、あいだにスペーサーを置かない。"
		]
	},
	"supports": {
		"anchor": true
	},
	"attributes": {
		"backgroundType": { "type": "string", "default": "image" },
		"imageUrlPc": { "type": "string", "default": "https://lite-word.com/sample_img/background/6.webp" },
		"imageUrlSp": { "type": "string", "default": "" },
		"imageAlt": { "type": "string", "default": "" },
		"bgColor": { "type": "string", "default": "#0a4653" },
		"filterColor": { "type": "string", "default": "#0a4653" },
		"filterOpacity": { "type": "number", "default": 0.82 },
		"minHeightPc": { "type": "string", "default": "min-h-pc-560px" },
		"minHeightTb": { "type": "string", "default": "min-h-tb-480px" },
		"minHeightSp": { "type": "string", "default": "" },
		"maxWidth": { "type": "number", "default": 1000 },
		"textAlign": { "type": "string", "default": "center" },
		"showEyebrow": { "type": "boolean", "default": true },
		"eyebrow": { "type": "string", "default": "相談だけでも大丈夫です" },
		"eyebrowColor": { "type": "string", "default": "#a9e2ea" },
		"headingLevel": { "type": "number", "default": 1 },
		"mainTitle": { "type": "string", "default": "かける前に、<br>聞きたいことだけ" },
		"titleColor": { "type": "string", "default": "#ffffff" },
		"titleFontWeight": { "type": "string", "default": "700" },
		"titleFont": { "type": "string", "default": "" },
		"titleFontSizePc": { "type": "number", "default": 46 },
		"titleFontSizeSp": { "type": "number", "default": 29 },
		"description": { "type": "string", "default": "お名前を言わなくても構いません。「いくらぐらいか」「うちでもできるか」だけでも、その場でお答えします。" },
		"descriptionColor": { "type": "string", "default": "#cfe8ec" },
		"ctaOrder": { "type": "string", "default": "tel-first" },
		"showTel": { "type": "boolean", "default": true },
		"telKicker": { "type": "string", "default": "いますぐ話す" },
		"telNumber": { "type": "string", "default": "0120-000-000" },
		"telSub": { "type": "string", "default": "平日 9:00–18:00 ／ 通話3分ほど" },
		"telHref": { "type": "string", "default": "0120000000" },
		"telAsLink": { "type": "boolean", "default": true },
		"telBgColor": { "type": "string", "default": "#ffffff" },
		"telTextColor": { "type": "string", "default": "#0a4653" },
		"telSubColor": { "type": "string", "default": "#5d6b70" },
		"showCta": { "type": "boolean", "default": true },
		"ctaKicker": { "type": "string", "default": "文字でたずねる" },
		"ctaText": { "type": "string", "default": "フォームで送る" },
		"ctaSub": { "type": "string", "default": "24時間受付 ／ 入力は30秒" },
		"ctaUrl": { "type": "string", "default": "" },
		"ctaLinkType": { "type": "string", "default": "url" },
		"ctaPageId": { "type": "number", "default": 0 },
		"ctaCategoryId": { "type": "number", "default": 0 },
		"ctaBgColor": { "type": "string", "default": "#e8913a" },
		"ctaTextColor": { "type": "string", "default": "#ffffff" },
		"ctaSubColor": { "type": "string", "default": "#fff2df" },
		"ctaBorderRadius": { "type": "number", "default": 9 },
		"showSafe": { "type": "boolean", "default": true },
		"safeItems": {
			"type": "array",
			"default": [
				{ "text": "番号を他社に渡しません" },
				{ "text": "折り返しは1回だけ" },
				{ "text": "相談だけで終わってOK" }
			]
		},
		"safeColor": { "type": "string", "default": "#bfe0e6" },
		"safeMarkColor": { "type": "string", "default": "#7fc4d0" }
	},
	"no": 19
}
